<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="10.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.statistics.StatisticsController">
   <children>
      <fx:include fx:id="runHistoryComponent" source="runtable/runTable.fxml" />
      <HBox alignment="CENTER" prefWidth="450.0" spacing="10.0">
         <children>
            <Button fx:id="showAllButton" mnemonicParsing="false" onAction="#showAllButtonAction" text="Show All" />
            <Button fx:id="rerunButton" mnemonicParsing="false" onAction="#rerunButtonAction" text="Re-Run" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.ApplicationController">
   <content>
      <BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" styleClass="root">
         <right>
            <VBox alignment="CENTER" BorderPane.alignment="CENTER">
               <children>
                  <fx:include fx:id="executionComponent" source="execution/execution.fxml" />
                  <fx:include fx:id="statisticsComponent" source="statistics/statistics.fxml" />
               </children>
            </VBox>
         </right>
         <left>
            <fx:include fx:id="programViewComponent" source="programview/programView.fxml" />
         </left>
         <top>
            <HBox BorderPane.alignment="CENTER">
               <children>
                  <fx:include fx:id="fileLoaderComponent" source="fileloader/fileLoader.fxml" />
                  <fx:include fx:id="settingsComponent" source="settings/settings.fxml" />
               </children>
            </HBox>
         </top>
      </BorderPane>
   </content>
</ScrollPane>

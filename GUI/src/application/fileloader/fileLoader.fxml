<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox prefWidth="600.0" spacing="5.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.fileloader.FileLoaderController">
   <children>
      <HBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="580.0" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#loadFileButtonAction" text="Load File" />
            <Label fx:id="currentPathLabel" prefHeight="17.0" prefWidth="468.0" text="Label" />
            <ProgressIndicator fx:id="loadFileTaskProgressIndicator" progress="0.0" />
         </children>
      </HBox>
      <Label fx:id="fileLoadingStatusLabel" text="Label" />
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="10.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.programview.ProgramViewController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <ChoiceBox prefHeight="25.0" prefWidth="81.0" />
            <ComboBox fx:id="selectedDegreeComboBox" onAction="#selectedDegreeComboBoxAction" prefHeight="25.0" prefWidth="142.0" />
            <Label fx:id="currentDegreeLabel" alignment="CENTER" prefHeight="17.0" prefWidth="42.0" text="Label" />
            <Button mnemonicParsing="false" prefHeight="25.0" prefWidth="87.0" text="Highlight Selection" />
         </children>
      </HBox>
      <TableView fx:id="instructionsTableView" prefHeight="180.0" prefWidth="380.0">
        <columns>
          <TableColumn fx:id="instructionNumberTableColumn" prefWidth="40.0" text="No." />
          <TableColumn fx:id="instructionTypeTableColumn" prefWidth="40.0" text="Type" />
            <TableColumn fx:id="instructionLabelTableColumn" prefWidth="40.0" text="Label" />
            <TableColumn fx:id="instructionDataTableColumn" prefWidth="110.0" text="Instruction" />
            <TableColumn fx:id="instructionCyclesTableColumn" prefWidth="30.0" text="Cycles" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label fx:id="summaryLineLabel" text="Label" />
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="450.0" spacing="10.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.programview.ProgramViewController">
   <children>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <ComboBox fx:id="chooseProgramComboBox" onAction="#chooseProgramComboBoxAction" prefWidth="110.0" promptText="Program" />
            <ComboBox fx:id="selectedDegreeComboBox" onAction="#selectedDegreeComboBoxAction" prefWidth="110.0" promptText="Degree" />
            <Label fx:id="currentDegreeLabel" alignment="CENTER" prefHeight="17.0" prefWidth="42.0" text="Label" />
            <ComboBox fx:id="highlightComboBox" onAction="#highlightComboBoxAction" prefWidth="110.0" promptText="Highlight" />
         </children>
      </HBox>
      <fx:include fx:id="programInstructionsComponent" source="instructionstable/instructionsTable.fxml" />
      <Label fx:id="summaryLineLabel" text="Label" />
      <fx:include fx:id="instructionHistoryComponent" prefHeight="100.0" source="instructionstable/instructionsTable.fxml" />
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>

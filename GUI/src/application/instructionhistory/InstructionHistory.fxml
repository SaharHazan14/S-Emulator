<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>


<HBox xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.instructionhistory.InstructionHistoryController">
   <children>
      <TableView fx:id="instructionTableView" prefHeight="140.0" prefWidth="380.0">
        <columns>
          <TableColumn fx:id="numberTableColumn" prefWidth="40.0" text="No." />
          <TableColumn fx:id="typeTableColumn" prefWidth="40.0" text="Type" />
            <TableColumn fx:id="labelTableColumn" prefWidth="40.0" text="Label" />
            <TableColumn fx:id="instructionDataTableColumn" prefWidth="110.0" text="Instruction" />
            <TableColumn fx:id="cyclesTableColumn" prefWidth="30.0" text="Cycles" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</HBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.execution.ExecutionController">
   <children>
      <HBox alignment="CENTER" spacing="5.0">
         <children>
            <Button mnemonicParsing="false" text="Step Over" />
            <Button mnemonicParsing="false" text="Stop" />
            <Button mnemonicParsing="false" text="Resume" />
            <Button mnemonicParsing="false" onAction="#runButtonAction" text="RUN" />
            <ToggleButton mnemonicParsing="false" text="Debug Mode" />
         </children>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
      <HBox alignment="CENTER" prefWidth="363.0" spacing="5.0">
         <children>
            <VBox prefHeight="306.0" prefWidth="178.0" spacing="5.0">
               <children>
                  <TableView fx:id="variablesResultTableView" prefHeight="264.0" prefWidth="120.0">
                    <columns>
                      <TableColumn fx:id="variableNameTableColumn" prefWidth="50.0" text="Variable" />
                      <TableColumn fx:id="variableValueTableColumn" prefWidth="50.0" text="Value" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <Label fx:id="cyclesConsumedLabel" text="Label" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            <ScrollPane fx:id="inputsScrollPane" prefHeight="306.0" prefWidth="159.0" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </children>
</VBox>
